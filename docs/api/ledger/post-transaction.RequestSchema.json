{"title":"Body","body":{"content":{"application/json":{"schema":{"type":"object","description":"A request to post one double-entry movement (used by the payments and\nbilling services via their cross-service M2M workloads).","required":["debit_balance_id","credit_balance_id","amount","currency","transaction_type"],"properties":{"amount":{"type":"string","description":"Amount as a decimal string."},"credit_balance_id":{"type":"string","format":"uuid","description":"Credit leg (destination balance)."},"currency":{"type":"string","description":"ISO 4217 currency code."},"debit_balance_id":{"type":"string","format":"uuid","description":"Debit leg (source balance)."},"idempotency_key":{"type":["string","null"],"description":"Caller-supplied idempotency key."},"source_id":{"type":["string","null"],"format":"uuid","description":"Originating resource id."},"source_type":{"type":["string","null"],"description":"Originating resource (`charge` / `payout` / …)."},"transaction_type":{"type":"string","description":"Movement type."}},"title":"PostTransactionRequest"}}},"required":true}}