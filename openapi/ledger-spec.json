{
  "openapi": "3.1.0",
  "info": {
    "title": "bill8-ledger",
    "description": "Sentin8 Bill8:Ledger - double-entry money engine, balances, payouts, transfers.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/accounts": {
      "get": {
        "tags": [
          "ledger"
        ],
        "summary": "`GET /v1/accounts`",
        "operationId": "list_accounts",
        "responses": {
          "200": {
            "description": "List of accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AccountResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:accounts:read"
          }
        },
        "security": [
          {
            "bill8:ledger:accounts:read": []
          }
        ],
        "description": "List accounts.\n\nlist ledger accounts."
      },
      "post": {
        "tags": [
          "ledger"
        ],
        "summary": "`POST /v1/accounts`",
        "operationId": "create_account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:accounts:write"
          }
        },
        "security": [
          {
            "bill8:ledger:accounts:write": []
          }
        ],
        "description": "Create account.\n\ncreate a ledger account with its standard\nbalances (`available`, `pending`)."
      }
    },
    "/v1/balance-transactions": {
      "get": {
        "tags": [
          "ledger"
        ],
        "summary": "`GET /v1/balance-transactions`",
        "operationId": "list_transactions",
        "parameters": [
          {
            "name": "balance_id",
            "in": "query",
            "description": "Filter by balance leg",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of transactions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BalanceTransaction"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:balance-transactions:read"
          }
        },
        "security": [
          {
            "bill8:ledger:balance-transactions:read": []
          }
        ],
        "description": "List transactions.\n\nlist movements (optionally by balance)."
      },
      "post": {
        "tags": [
          "ledger"
        ],
        "summary": "`POST /v1/balance-transactions`",
        "description": "The money path: BEGIN → tenant context → idempotency check →\ncurrency/currency validation → row-lock both balances → append the\ntransaction → mutate both balance rows → outbox (same tx) → COMMIT.\nA rejected batch writes NOTHING (imbalanced, currency mismatch, or\ninsufficient debit funds all fail pre-write).\n\npost one double-entry movement.",
        "operationId": "post_transaction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Transaction posted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceTransaction"
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:balance-transactions:write"
          },
          "422": {
            "description": "Imbalanced/currency-mismatch - nothing written"
          }
        },
        "security": [
          {
            "bill8:ledger:balance-transactions:write": []
          }
        ]
      }
    },
    "/v1/balances": {
      "get": {
        "tags": [
          "ledger"
        ],
        "summary": "`GET /v1/balances`",
        "operationId": "list_balances",
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "description": "Filter by account",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Filter by balance name",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of balances",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Balance"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:balances:read"
          }
        },
        "security": [
          {
            "bill8:ledger:balances:read": []
          }
        ],
        "description": "List balances.\n\nlist balances (optionally filtered)."
      }
    },
    "/v1/balances/{id}": {
      "get": {
        "tags": [
          "ledger"
        ],
        "summary": "`GET /v1/balances/{id}`",
        "operationId": "get_balance",
        "responses": {
          "200": {
            "description": "The balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                }
              }
            }
          },
          "404": {
            "description": "Balance not found"
          }
        },
        "security": [
          {
            "bill8:ledger:balances:read": []
          }
        ],
        "description": "Get balance.\n\nread one balance."
      }
    },
    "/v1/fees": {
      "get": {
        "tags": [
          "ledger"
        ],
        "summary": "`GET /v1/fees`",
        "operationId": "list_fees",
        "responses": {
          "200": {
            "description": "List of fee entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FeeResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:fees:read"
          }
        },
        "security": [
          {
            "bill8:ledger:fees:read": []
          }
        ],
        "description": "List fees.\n\nlist the configured fee model."
      },
      "post": {
        "tags": [
          "ledger"
        ],
        "summary": "`POST /v1/fees`",
        "operationId": "upsert_fee",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertFeeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Fee model saved"
          },
          "403": {
            "description": "Missing bill8:ledger:fees:write"
          }
        },
        "security": [
          {
            "bill8:ledger:fees:write": []
          }
        ],
        "description": "Upsert fee.\n\nupsert the fee model for a transaction type."
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "`GET /v1/health`",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Liveness (status, service, version, build)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthBuild"
                }
              }
            }
          }
        },
        "security": [],
        "description": "Health .\n\nHealth probe payload."
      }
    },
    "/v1/internal/payout-schedules/run": {
      "post": {
        "tags": [
          "ledger"
        ],
        "summary": "`POST /v1/internal/payout-schedules/run`",
        "operationId": "run_payout_schedules",
        "responses": {
          "200": {
            "description": "Tick processed"
          }
        },
        "security": [
          {
            "sentin8:cron:write": []
          }
        ],
        "description": "Run payout schedules.\n\nthe Cron proxy-back tick.\nCreates a payout for each enabled schedule whose available balance\nmeets its minimum. At most one payout per tick (the balance guard\nitself enforces it: the available row lock serializes)."
      }
    },
    "/v1/payout-schedules": {
      "get": {
        "tags": [
          "ledger"
        ],
        "summary": "`GET /v1/payout-schedules`",
        "operationId": "list_payout_schedules",
        "responses": {
          "200": {
            "description": "List of schedules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PayoutScheduleResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:payout-schedules:read"
          }
        },
        "security": [
          {
            "bill8:ledger:payout-schedules:read": []
          }
        ],
        "description": "List payout schedules.\n\nlist schedules."
      },
      "post": {
        "tags": [
          "ledger"
        ],
        "summary": "`POST /v1/payout-schedules`",
        "operationId": "create_payout_schedule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePayoutScheduleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Schedule created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayoutScheduleResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:payout-schedules:write"
          }
        },
        "security": [
          {
            "bill8:ledger:payout-schedules:write": []
          }
        ],
        "description": "Create payout schedule.\n\ncreate an automatic payout schedule."
      }
    },
    "/v1/payout-schedules/{id}": {
      "delete": {
        "tags": [
          "ledger"
        ],
        "summary": "`DELETE /v1/payout-schedules/{id}`",
        "operationId": "delete_payout_schedule",
        "responses": {
          "200": {
            "description": "Schedule disabled"
          },
          "404": {
            "description": "Schedule not found"
          }
        },
        "security": [
          {
            "bill8:ledger:payout-schedules:write": []
          }
        ],
        "description": "Delete payout schedule.\n\ndisable a schedule."
      }
    },
    "/v1/payouts": {
      "get": {
        "tags": [
          "ledger"
        ],
        "summary": "`GET /v1/payouts`",
        "operationId": "list_payouts",
        "responses": {
          "200": {
            "description": "List of payouts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Payout"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:payouts:read"
          }
        },
        "security": [
          {
            "bill8:ledger:payouts:read": []
          }
        ],
        "description": "List payouts.\n\nlist payouts."
      },
      "post": {
        "tags": [
          "ledger"
        ],
        "summary": "`POST /v1/payouts`",
        "operationId": "create_payout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePayoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Payout created (pending)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payout"
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:payouts:write"
          },
          "422": {
            "description": "Insufficient available balance - nothing written"
          }
        },
        "security": [
          {
            "bill8:ledger:payouts:write": []
          }
        ],
        "description": "Create payout.\n\npay out available balance to an external account."
      }
    },
    "/v1/payouts/{id}": {
      "get": {
        "tags": [
          "ledger"
        ],
        "summary": "`GET /v1/payouts/{id}`",
        "operationId": "get_payout",
        "responses": {
          "200": {
            "description": "The payout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payout"
                }
              }
            }
          },
          "404": {
            "description": "Payout not found"
          }
        },
        "security": [
          {
            "bill8:ledger:payouts:read": []
          }
        ],
        "description": "Get payout.\n\nread one payout."
      }
    },
    "/v1/transfers": {
      "get": {
        "tags": [
          "ledger"
        ],
        "summary": "`GET /v1/transfers`",
        "operationId": "list_transfers",
        "responses": {
          "200": {
            "description": "List of transfers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Transfer"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:transfers:read"
          }
        },
        "security": [
          {
            "bill8:ledger:transfers:read": []
          }
        ],
        "description": "List transfers.\n\nlist transfers."
      },
      "post": {
        "tags": [
          "ledger"
        ],
        "summary": "`POST /v1/transfers`",
        "operationId": "create_transfer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Transfer created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transfer"
                }
              }
            }
          },
          "403": {
            "description": "Missing bill8:ledger:transfers:write"
          },
          "422": {
            "description": "Insufficient funds - nothing written"
          }
        },
        "security": [
          {
            "bill8:ledger:transfers:write": []
          }
        ],
        "description": "Create transfer.\n\nmove funds between connected balances."
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "type": "object",
        "description": "Account response shape.",
        "required": [
          "id",
          "account_type",
          "display_name",
          "created_at"
        ],
        "properties": {
          "account_type": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Balance": {
        "type": "object",
        "description": "A named money position per currency, e.g. `available` or `platform_fee`.",
        "required": [
          "id",
          "account_id",
          "name",
          "currency",
          "amount",
          "updated_at"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "description": "Owning ledger account."
          },
          "amount": {
            "type": "string",
            "description": "Amount as a JSON string on the wire (money is never a float)."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Balance id."
          },
          "name": {
            "type": "string",
            "description": "Balance name (`available` / `pending` / `connected_reserved` /\n`platform_fee`)."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp."
          }
        }
      },
      "BalanceTransaction": {
        "type": "object",
        "description": "An append-only double-entry movement debiting one balance and\ncrediting another.",
        "required": [
          "id",
          "debit_balance_id",
          "credit_balance_id",
          "amount",
          "currency",
          "transaction_type",
          "created_at"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "description": "Amount as a JSON string on the wire."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp."
          },
          "credit_balance_id": {
            "type": "string",
            "format": "uuid",
            "description": "Credit leg (destination balance)."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code."
          },
          "debit_balance_id": {
            "type": "string",
            "format": "uuid",
            "description": "Debit leg (source balance)."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Transaction id."
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Originating resource id."
          },
          "source_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Originating resource (`charge` / `payout` / …)."
          },
          "transaction_type": {
            "type": "string",
            "description": "Movement type (`charge` / `refund` / `payout` / `transfer` / `fee`\n/ `fx` / `dispute_reversal`)."
          }
        }
      },
      "CreateAccountRequest": {
        "type": "object",
        "description": "Request body for `POST /v1/accounts`.",
        "required": [
          "account_type",
          "display_name"
        ],
        "properties": {
          "account_type": {
            "type": "string",
            "description": "Account family (`customer` / `platform` / `connected`)."
          },
          "display_name": {
            "type": "string",
            "description": "Display name."
          }
        }
      },
      "CreatePayoutRequest": {
        "type": "object",
        "description": "Request body for `POST /v1/payouts`.",
        "required": [
          "account_id",
          "external_account_ref",
          "amount",
          "currency"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "description": "Ledger account being paid out."
          },
          "amount": {
            "type": "string",
            "description": "Amount as a decimal string."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code of the payout."
          },
          "external_account_ref": {
            "type": "string",
            "description": "External account destination (secret-by-reference)."
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Caller-supplied idempotency key."
          }
        }
      },
      "CreatePayoutScheduleRequest": {
        "type": "object",
        "description": "Request body for `POST /v1/payout-schedules`.",
        "required": [
          "account_id",
          "external_account_ref",
          "interval",
          "minimum_amount",
          "currency"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "description": "The ledger account to pay out."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code."
          },
          "external_account_ref": {
            "type": "string",
            "description": "The external-account destination (secret-by-reference)."
          },
          "interval": {
            "type": "string",
            "description": "The payout interval (`daily` / `weekly` / `monthly`)."
          },
          "minimum_amount": {
            "type": "string",
            "description": "Payouts fire only when available ≥ minimum."
          }
        }
      },
      "CreateTransferRequest": {
        "type": "object",
        "description": "Request body for `POST /v1/transfers`.",
        "required": [
          "from_balance_id",
          "to_balance_id",
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "from_balance_id": {
            "type": "string",
            "format": "uuid"
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "to_balance_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "FeeResponse": {
        "type": "object",
        "description": "Fee-model response.",
        "required": [
          "id",
          "transaction_type",
          "fixed_amount",
          "bps",
          "currency"
        ],
        "properties": {
          "bps": {
            "type": "integer",
            "format": "int32"
          },
          "currency": {
            "type": "string"
          },
          "fixed_amount": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transaction_type": {
            "type": "string"
          }
        }
      },
      "HealthBuild": {
        "type": "object",
        "description": "The liveness payload every Bill8 service returns at\n`GET /v1/health` (tag `meta`): status, serving service short\nname, build identity.",
        "required": [
          "status",
          "service",
          "version",
          "build"
        ],
        "properties": {
          "build": {
            "type": "string",
            "description": "Build hash (`sentin8::build_info::build_hash()`)."
          },
          "service": {
            "type": "string",
            "description": "The serving service short name (e.g. `ledger`)."
          },
          "status": {
            "type": "string",
            "description": "Always `ok` on a live instance."
          },
          "version": {
            "type": "string",
            "description": "Build identity id (`sentin8::build_info::id()`)."
          }
        }
      },
      "Payout": {
        "type": "object",
        "description": "A withdrawal of available balance to an external account.",
        "required": [
          "id",
          "env_id",
          "account_id",
          "external_account_ref",
          "amount",
          "currency",
          "status",
          "created_at"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "description": "Ledger account being paid out."
          },
          "amount": {
            "type": "string",
            "description": "Amount as a JSON string on the wire."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code."
          },
          "env_id": {
